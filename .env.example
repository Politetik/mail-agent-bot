# ─────────────────────────────────────────────────────────────
#  Почтовый ИИ-агент: Telegram + Mail.ru
#  Скопируйте этот файл в .env и заполните значения.
# ─────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────
# Токен от @BotFather (Telegram → @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Белый список chat_id, которым разрешён доступ (через запятую).
# Оставьте пустым при первом запуске: бот покажет ваш chat_id в ответ на /start.
# Пример: 123456789,987654321
ALLOWED_CHAT_IDS=

# ── Почта: Mail.ru или Яндекс (IMAP/SMTP) ─────────────────────
# Полный адрес ящика
MAIL_USER=you@mail.ru

# НЕ обычный пароль! Пароль приложения:
# Mail.ru → Настройки → Безопасность → «Пароли для внешних приложений» → создать.
# Яндекс  → id.yandex.ru → Безопасность → «Пароли приложений» → создать.
MAIL_PASSWORD=

# Mail.ru (по умолчанию)
MAIL_IMAP_HOST=imap.mail.ru
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465

# Яндекс.Почта — замените хосты на эти и включите IMAP:
# Настройки → Почтовые программы → «Разрешить доступ по IMAP».
#   MAIL_IMAP_HOST=imap.yandex.ru
#   MAIL_SMTP_HOST=smtp.yandex.ru

# Папки для чтения через запятую (INBOX — «Входящие»)
MAIL_FOLDERS=INBOX
# Также читать «Отправленные» (полезно для анализа переговоров)
MAIL_INCLUDE_SENT=true

# ── ИИ (OpenAI-совместимый API) ───────────────────────────────
# Провайдер: deepseek | openai | openrouter | ollama | lmstudio
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Модель: для DeepSeek — deepseek-chat, для OpenAI — gpt-4o-mini
LLM_MODEL=deepseek-chat
# Своя точка входа (нужна для Ollama/LM Studio или корпоративного шлюза)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# ── Распознавание голоса ──────────────────────────────────────
STT_ENABLED=true
# local — faster-whisper на вашей машине (без ключей, без VPN)
# openai — Whisper API (нужен ключ), yandex — заготовка
STT_PROVIDER=local
# small — быстро (RTF ~0.5 на CPU), medium — точнее, но медленнее реального времени
STT_MODEL=small
STT_LANGUAGE=ru
# auto | cpu | cuda (для cuda нужны CUDA 12 и cuDNN 9)
STT_DEVICE=auto
# auto | int8 | float16 | float32
STT_COMPUTE_TYPE=auto
# Куда качать модели (по умолчанию data/models)
# STT_CACHE_DIR=data/models
STT_API_KEY=
# STT_BASE_URL=http://127.0.0.1:8000/v1

# ── Синхронизация ─────────────────────────────────────────────
# Сколько дней истории читать при первом запуске
SYNC_DAYS=30
# Максимум писем за одну синхронизацию
SYNC_LIMIT=300
# Насколько глубоко разбирать письма за раз
ANALYZE_LIMIT=60
# Пропускать рассылки
SKIP_BULK=true
# Автопроверка почты, минут (0 — выключено)
AUTO_SYNC_MIN=0

# Через сколько дней без ответа считать тред «зависшим» (напоминание о follow-up)
FOLLOW_UP_DAYS=3

# ── Прочее ────────────────────────────────────────────────────
DB_PATH=data/mail-agent.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=info
